# ============ LangchainRAG 配置文件 ============
# 使用方法：把本文件复制一份、改名为 .env，然后修改里面的值。
# 注意：修改后需要重启系统才生效（双击 4-启动系统.bat 重开）。

# ---- DeepSeek 大模型（必填）----
# 登录 platform.deepseek.com → 左侧「API keys」→ 创建，复制 sk- 开头的那串字符
DEEPSEEK_API_KEY=
# 模型名（一般不用改；如报「模型不存在」，去 DeepSeek 官网核对最新模型名）
DEEPSEEK_MODEL=deepseek-flash

# ---- 管理员账号（首次启动时自动创建，仅生效一次）----
# 为了安全，管理员密码不写在代码里，请在此处设置你自己的密码
# 注意：只在"管理员账号不存在"时创建；已创建后再改这里不会重置密码
ADMIN_USERNAME=7Nanometer
ADMIN_PASSWORD=

# ---- 本地模型位置（一般不用改，除非你把模型挪了地方）----
EMBEDDING_MODEL_PATH=F:\LangchainRAG-data\models\bge-large-zh-v1.5
RERANKER_MODEL_PATH=F:\LangchainRAG-data\models\bge-reranker-v2-m3
# 计算设备：auto=自动（优先显卡，不够就退回CPU）/ cuda=强制显卡 / cpu=强制CPU
MODEL_DEVICE=auto

# ---- 性能参数（新手建议保持默认）----
# 每用户每分钟最多提问次数（防 API 费用失控）
RATE_LIMIT_PER_MINUTE=20
# 问答缓存：换个说法问同一问题，相似度超过该值直接秒回旧答案
CACHE_SIMILARITY_THRESHOLD=0.92
